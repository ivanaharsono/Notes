<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="FormatToggleButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="backgroundTint">@null</item>
        <item name="iconTint">@color/ic_tint_selector</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
    </style>

    <style name="CircleImage">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="OtpBoxStyle">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:background">@drawable/bg_otp_circle</item>
        <item name="android:gravity">center</item>
        <item name="android:inputType">number</item>
        <item name="android:maxLength">1</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/IndigoBlue</item>
        <item name="android:textStyle">bold</item>
        <item name="android:cursorVisible">false</item>
        <item name="android:textAlignment">center</item>
        <item name="android:padding">0dp</item>
    </style>
</resources>