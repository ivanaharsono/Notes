<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F9FA">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/white"
        app:navigationIcon="@drawable/ic_back"
        app:title="Help &amp; Feedback"
        app:titleTextAppearance="@style/TextAppearance.AppCompat.Medium"
        app:elevation="2dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- ── SECTION: FAQ ── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingTop="20dp"
                android:paddingBottom="8dp"
                android:text="Frequently Asked Questions"
                android:textSize="12sp"
                android:fontFamily="@font/inter_bold"
                android:textColor="@color/IndigoBlue"
                android:textAllCaps="true"
                android:letterSpacing="0.1" />

            <!-- FAQ Item 1 -->
            <LinearLayout
                android:id="@+id/faq1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp"
                android:background="@android:color/white"
                android:foreground="?attr/selectableItemBackground">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="How do I create a new note?"
                    android:textSize="15sp"
                    android:fontFamily="@font/inter_bold"
                    android:textColor="@color/black" />
                <TextView
                    android:id="@+id/faq1Answer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Tap the blue &quot;+&quot; button at the bottom-right of the main screen to open the note editor."
                android:textSize="14sp"
                android:fontFamily="@font/inter_regular"
                android:textColor="@color/gray_text"
                android:visibility="gone" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E0E0E0" android:layout_marginStart="16dp" />

            <!-- FAQ Item 2 -->
            <LinearLayout
                android:id="@+id/faq2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp"
                android:background="@android:color/white"
                android:foreground="?attr/selectableItemBackground">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="How do I format text in a note?"
                    android:textSize="15sp"
                    android:fontFamily="@font/inter_bold"
                    android:textColor="@color/black" />
                <TextView
                    android:id="@+id/faq2Answer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Inside the note editor, tap the format icon (Aa) at the bottom-left to reveal the formatting toolbar. You can apply Bold, Italic, Underline, and Bullet List."
                    android:textSize="14sp"
                    android:fontFamily="@font/inter_regular"
                    android:textColor="@color/gray_text"
                    android:visibility="gone" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E0E0E0" android:layout_marginStart="16dp" />

            <!-- FAQ Item 3 -->
            <LinearLayout
                android:id="@+id/faq3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp"
                android:background="@android:color/white"
                android:foreground="?attr/selectableItemBackground">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="How do I archive or delete a note?"
                    android:textSize="15sp"
                    android:fontFamily="@font/inter_bold"
                    android:textColor="@color/black" />
                <TextView
                    android:id="@+id/faq3Answer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Long-press on any note card in the main screen to see the Archive and Delete options. Archived notes go to Archive; deleted notes go to Trash."
                    android:textSize="14sp"
                    android:fontFamily="@font/inter_regular"
                    android:textColor="@color/gray_text"
                    android:visibility="gone" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E0E0E0" android:layout_marginStart="16dp" />

            <!-- FAQ Item 4 -->
            <LinearLayout
                android:id="@+id/faq4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp"
                android:background="@android:color/white"
                android:foreground="?attr/selectableItemBackground">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Are my notes saved automatically?"
                    android:textSize="15sp"
                    android:fontFamily="@font/inter_bold"
                    android:textColor="@color/black" />
                <TextView
                    android:id="@+id/faq4Answer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="No. You must tap the &quot;Save&quot; button in the note editor to save your changes. If you leave without saving, changes will be lost."
                android:textSize="14sp"
                android:fontFamily="@font/inter_regular"
                android:textColor="@color/gray_text"
                android:visibility="gone" />
            </LinearLayout>

            <!-- ── SECTION: Send Feedback ── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingTop="24dp"
                android:paddingBottom="8dp"
                android:text="Send Feedback"
                android:textSize="12sp"
                android:fontFamily="@font/inter_bold"
                android:textColor="@color/IndigoBlue"
                android:textAllCaps="true"
                android:letterSpacing="0.1" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilFeedback"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Describe your issue or suggestion...">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etFeedback"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_regular"
                            android:gravity="top"
                            android:inputType="textMultiLine|textCapSentences"
                            android:minLines="4"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSendFeedback"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="12dp"
                        android:backgroundTint="@color/IndigoBlue"
                        android:fontFamily="@font/inter_font_family"
                        android:text="Send Feedback"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        app:cornerRadius="12dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- App version info di bagian bawah -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Notes App v1.0.0 · Made with ♥ by Angels"
                android:textSize="12sp"
                android:fontFamily="@font/inter_regular"
                android:textColor="@color/gray_text"
                android:gravity="center" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>