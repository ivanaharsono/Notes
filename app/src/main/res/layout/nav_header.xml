<?xml version="1.0" encoding="utf-8"?>
<!--
    nav_header.xml
    Layout untuk bagian atas (header) dari Sidebar / Navigation Drawer.

    Header ini menampilkan:
    - Logo / ikon aplikasi Notes
    - Nama aplikasi
    - Tagline singkat

    Digunakan oleh NavigationView melalui atribut app:headerLayout="@layout/nav_header"
    di dalam activity_main.xml.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:paddingTop="48dp"
    android:background="@color/IndigoBlue">

    <!-- Logo Aplikasi -->
    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/ic_notes_logo"
        android:contentDescription="Notes Logo"
        app:tint="@android:color/white" />

    <!-- Nama Aplikasi -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="My Notes"
        android:textColor="@android:color/white"
        android:textSize="22sp"
        android:fontFamily="@font/inter_bold" />

    <!-- Tagline -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Capture your ideas anywhere"
        android:textColor="#B3FFFFFF"
        android:textSize="13sp"
        android:fontFamily="@font/inter_regular" />

</LinearLayout>