<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/noteCard"
    android:layout_width="match_parent"
    android:layout_height="132dp"
    android:layout_margin="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@android:color/white">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:id="@+id/labelAccent"
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="@color/IndigoBlue"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="44dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/tvItemTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:text="Judul Catatan"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tvItemDescription"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/inter_regular"
                android:text="Isi catatan yang lebih dinamis akan muncul di sini..."
                android:textColor="#666666"
                android:textSize="14sp"
                android:ellipsize="end"
                android:maxLines="2" />

            <TextView
                android:id="@+id/tvItemLabel"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:gravity="center"
                android:background="@drawable/bg_label_chip"
                android:paddingHorizontal="10dp"
                android:text="Work"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:visibility="invisible" />

        </LinearLayout>

        <CheckBox
            android:id="@+id/cbSelected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:buttonTint="@color/IndigoBlue"
            android:clickable="false"
            android:focusable="false"
            android:visibility="gone" />

    </FrameLayout>

</androidx.cardview.widget.CardView>